#!/usr/bin/env bash
set -euo pipefail
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
python_bin="$repo_root/.venv/bin/python"
[[ -x "$python_bin" ]] || { echo "run uv sync first" >&2; exit 1; }
export DIMON_PROJECT_PYTHON="$python_bin"
exec "$python_bin" -m services.gpu_host.host_cli start "$@"
