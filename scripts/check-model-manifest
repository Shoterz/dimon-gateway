#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ -x "$repo_root/.venv/bin/python" ]]; then
  exec "$repo_root/.venv/bin/python" -m services.gpu_host.model_manifest "$@"
fi
exec uv run --project "$repo_root" python -m services.gpu_host.model_manifest "$@"
