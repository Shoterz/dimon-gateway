# Compatibility pointer: the canonical template is ../../.env.example.
# From the repository root, create the active app configuration with:
# cp .env.example apps/dimon_live/.env
# Explicit shell or service variables override values loaded from that file.

# These compatibility values keep the existing app-local setup self-contained.
DIMON_INFERENCE_MODE=fixture
DIMON_ALLOWED_ORIGINS=http://127.0.0.1:8890
DIMON_OWNER_ORIGIN=https://dimon-staging.stocksuite.app
DIMON_OWNER_ACCESS_AUDIENCE=
DIMON_LOCAL_HEALTH=0
DIMON_DB_OWNER_PATH=runtime/ledgers/owner.sqlite3
DIMON_VISITOR_DB_DIR=runtime/ledgers/visitors
DIMON_AUDIO_DIR=runtime/audio
DIMON_VISITOR_TTL_SECONDS=3600
DIMON_MAX_VISITOR_SESSIONS=25
DIMON_INFERENCE_GATEWAY_URL=https://dimon-inference.stocksuite.app
DIMON_CF_ACCESS_CLIENT_ID=
DIMON_CF_ACCESS_CLIENT_SECRET=
DIMON_QWEN_API_BASE=http://127.0.0.1:8080/v1
DIMON_QWEN_MODEL=qwen35-9b-abliterated-q5
DIMON_NEMOTRON_URL=ws://127.0.0.1:8004/v1/realtime
DIMON_KOKORO_URL=http://127.0.0.1:3001
DIMON_STT_BACKEND=nemotron
DIMON_WHISPER_URL=ws://127.0.0.1:8005/v1/stream
DIMON_WHISPER_CPP_URL=ws://127.0.0.1:8006/v1/stream
DIMON_NEMOTRON_CONNECT_TIMEOUT=3
DIMON_NEMOTRON_RESULT_TIMEOUT=15
DIMON_NEMOTRON_START_TIMEOUT=120
DIMON_MAX_AUDIO_BYTES=4000000
DIMON_MAX_UTTERANCE_SECONDS=30
DIMON_VOICE_PAUSE_SECONDS=0.3
DIMON_VOICE_ENDPOINT_SILENCE_SECONDS=1.4
DIMON_VOICE_SPEECH_THRESHOLD=0.015
DIMON_MAX_WAV_BYTES=8388608
