{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "kind", "actions", "size_kind", "quantity", "quantity_evidence", "allocation_evidence"],
  "properties": {
    "contract_version": {"const": 3},
    "kind": {"const": "INVESTMENT_FOLLOW_UP"},
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "BUY_NOW",
          "SET_LIMIT",
          "CANCEL",
          "USE_AVAILABLE_FUNDS",
          "CHANGE_FUNDING_ACCOUNT",
          "DAY",
          "GTC",
          "UNKNOWN"
        ]
      }
    },
    "size_kind": {"enum": ["QUANTITY", "ALLOCATION", "UNKNOWN"]},
    "quantity": {"type": ["integer", "null"], "minimum": 1, "maximum": 100000},
    "quantity_evidence": {"type": ["string", "null"]},
    "allocation_evidence": {"type": ["string", "null"]}
  }
}
