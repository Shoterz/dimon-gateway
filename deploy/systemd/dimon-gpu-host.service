[Unit]
Description=Dimon project-owned GPU inference services
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=@REPO_ROOT@
EnvironmentFile=@ENV_FILE@
ExecStart=@REPO_ROOT@/scripts/start-host --mode standalone --components raw
ExecStop=@REPO_ROOT@/scripts/stop-host
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
