[Unit]
Description=Dimon bounded inference gateway
After=network.target
After=dimon-gpu-host.service
Requires=dimon-gpu-host.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=@REPO_ROOT@
EnvironmentFile=@ENV_FILE@
Environment=DIMON_PROJECT_PYTHON=@REPO_ROOT@/.venv/bin/python
ExecStart=@REPO_ROOT@/services/inference_gateway/run.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
