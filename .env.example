# Generic non-secret configuration template for fixture/local development.
# Copy this file to apps/dimon_live/.env for local overrides; never commit it.

# Inference mode: fixture, remote, or local. Fixture is the teammate default.
DIMON_INFERENCE_MODE=fixture

# Web process
DIMON_HOST=127.0.0.1
DIMON_PORT=8890
DIMON_ALLOWED_ORIGINS=http://127.0.0.1:8890
DIMON_OWNER_ORIGIN=https://dimon-staging.stocksuite.app
DIMON_OWNER_ACCESS_AUDIENCE=
DIMON_LOCAL_HEALTH=0
DIMON_CONVERSATIONS_ENABLED=1

# Local synthetic state
DIMON_DB_OWNER_PATH=runtime/ledgers/owner.sqlite3
DIMON_VISITOR_DB_DIR=runtime/ledgers/visitors
DIMON_AUDIO_DIR=runtime/audio
DIMON_VISITOR_TTL_SECONDS=3600
DIMON_MAX_VISITOR_SESSIONS=25

# Remote inference. Supply the key only through an ignored local environment.
DIMON_INFERENCE_GATEWAY_URL=https://tencentservices.stocksuite.app
DIMON_INFERENCE_SERVICE_KEY=
DIMON_INFERENCE_TIMEOUT_SECONDS=30
DIMON_INFERENCE_MAX_RESPONSE_BYTES=1048576

# GPU-host inference gateway process. Set the shared key to match the teammate config.
DIMON_GATEWAY_HOST=127.0.0.1
DIMON_GATEWAY_PORT=8891
DIMON_GATEWAY_MAX_RAW_OUTPUT_BYTES=8192
DIMON_GATEWAY_STT_BACKEND=dual

# GPU-host local inference endpoints. Raw services stay on loopback.
DIMON_QWEN_API_BASE=http://127.0.0.1:8080/v1
DIMON_QWEN_MODEL=qwen35-9b-abliterated-q5
DIMON_QWEN_REVISION=
DIMON_NEMOTRON_URL=ws://127.0.0.1:8004/v1/realtime
DIMON_NEMOTRON_CONTROL_SOCKET=
DIMON_NEMOTRON_REVISION=
DIMON_KOKORO_URL=http://127.0.0.1:3001
DIMON_KOKORO_REVISION=
DIMON_STT_BACKEND=whisper_cpp
DIMON_WHISPER_URL=ws://127.0.0.1:8007/ws
DIMON_WHISPER_REVISION=faster-whisper-medium-cuda
DIMON_WHISPER_CONNECT_TIMEOUT=3
DIMON_WHISPER_RESULT_TIMEOUT=30
DIMON_WHISPER_CPP_URL=ws://127.0.0.1:8006/v1/stream
DIMON_WHISPER_CPP_CONNECT_TIMEOUT=3
DIMON_WHISPER_CPP_RESULT_TIMEOUT=90

# Standalone GPU-host artifact and runtime paths. Keep these outside Git.
DIMON_QWEN_MODEL_PATH=
DIMON_LLAMA_SERVER_PATH=
DIMON_NEMOTRON_MODEL_PATH=
DIMON_NEMO_SPEECH_PATH=
DIMON_NEMO_SPEECH_MODEL_DIR=
DIMON_KOKORO_MODEL_PATH=
DIMON_KOKORO_CONFIG_PATH=
DIMON_KOKORO_VOICE_PATH=
DIMON_KOKORO_PYTHON=
DIMON_WHISPER_MODEL_PATH=
DIMON_WHISPER_PYTHON=
DIMON_WHISPER_DEVICE=GPU
DIMON_WHISPER_CPP_MODEL_PATH=
DIMON_WHISPER_CPP_BINARY_PATH=

# Project-local CUDA Medium service. These must resolve beneath this repository's
# .runtime tree; scripts/install-faster-whisper-medium creates them there.
DIMON_FASTER_WHISPER_PYTHON=
DIMON_FASTER_WHISPER_MODEL_PATH=
DIMON_GPU_OVERLORD_CLIENT_DIR=
# User services normally expose this as /run/user/<uid>/gpu-overlord-<uid>.sock.
DIMON_GPU_OVERLORD_SOCKET=
# Ordered worker stop list; restart happens in reverse order.
DIMON_GPU_RESET_UNITS=dimon-faster-whisper-medium.service,jarvis-nemotron.service,gpu-overlord-stack.service

# Bounded voice and speech settings
DIMON_NEMOTRON_CONNECT_TIMEOUT=3
DIMON_NEMOTRON_RESULT_TIMEOUT=15
DIMON_NEMOTRON_START_TIMEOUT=120
DIMON_MAX_AUDIO_BYTES=4000000
DIMON_MAX_UTTERANCE_SECONDS=30
DIMON_VOICE_PAUSE_SECONDS=0.3
DIMON_VOICE_ENDPOINT_SILENCE_SECONDS=1.4
DIMON_VOICE_SPEECH_THRESHOLD=0.015
DIMON_MAX_WAV_BYTES=8388608

# Face registration (KYC) and face confirmation of every transaction.
# install.cmd downloads these; empty means %LOCALAPPDATA%\DimonGateway\models\face
DIMON_FACE_DETECTOR_PATH=
DIMON_FACE_RECOGNIZER_PATH=

# Voiceprint (hands-free confirmation of payments under S$200).
# install.cmd downloads it; empty means %LOCALAPPDATA%\DimonGateway\models\voice
DIMON_SPEAKER_MODEL_PATH=
# How many utterances the primary speech recogniser may handle at once.
# Whisper defaults to one utterance per process.
DIMON_VOICE_CONCURRENCY=

# Scale: 0 removes the cap on anonymous sessions (set this for real traffic).
# Ledgers kept open per process, and how often expired ones are swept.
DIMON_LEDGER_CACHE_SIZE=4096
DIMON_LEDGER_SWEEP_SECONDS=300

# Optional TRTC outage fallback (see README). Secrets stay blank here.
# Complete ASR credentials enable recognition fallback; complete cloud API
# credentials enable synthesis fallback. Fixture mode never calls TRTC.
DIMON_TRTC_SDK_APP_ID=
DIMON_TRTC_SDK_SECRET_KEY=
DIMON_TRTC_SECRET_ID=
DIMON_TRTC_SECRET_KEY=
DIMON_TRTC_REGION=ap-singapore
DIMON_TRTC_LANGUAGE=en
DIMON_TRTC_ASR_SITE=intl
DIMON_TRTC_ASR_ENGINE=bigmodel
DIMON_TRTC_TTS_VOICE_ID=v-female-p9Xy7Q1L
